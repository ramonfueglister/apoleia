#!/bin/sh
# Open the normal game at Verona's authored residential neighbourhood.
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
godot_bin=${GODOT_BIN:-$(command -v godot || echo /Applications/Godot.app/Contents/MacOS/Godot)}
"$godot_bin" --headless --path "$project_root/app" --editor --import
exec "$godot_bin" --path "$project_root/app" res://landscape.tscn -- --view=10.9816,45.4445,3.0 "$@"
