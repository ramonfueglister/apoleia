; Own project; no third party game assets.
config_version=5

[application]
config/name="Roma Aeterna — Landscape"
run/main_scene="res://landscape.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.09, 0.22, 0.30, 1)

lights_and_shadows/directional_shadow/size=4096
