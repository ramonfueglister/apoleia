; Own project; no third party game assets.
config_version=5

[application]
config/name="Apoleia — Landscape"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/mode=0
window/size/borderless=false
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=false
environment/ssao/quality=1
environment/defaults/default_clear_color=Color(0.09, 0.22, 0.30, 1)

lights_and_shadows/directional_shadow/size=2048

[shader_globals]

weather_wind_dir={
"type": "vec2",
"value": Vector2(0.7071, -0.7071)
}
weather_wind_strength={
"type": "float",
"value": 0.35
}
weather_storm={
"type": "float",
"value": 0.0
}
weather_cloud_shadow={
"type": "sampler2D",
"value": ""
}
weather_cloud_shadow_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
weather_wetness={
"type": "float",
"value": 0.0
}
weather_lightning={
"type": "float",
"value": 0.0
}
