          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sources_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping_revision": {
      "anyOf": [
