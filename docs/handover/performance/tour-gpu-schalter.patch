 	// coast flags: land next to the sea gets a beach, sea next to land a lagoon tint
 	coast = 0.0;
 	// sea tile: bit k = land across side k, bit 4 + k = land at corner k only;
@@ -283,6 +291,7 @@ void vertex() {
 	if (part == 0 && tile_km <= 0.5 && (shore_sides & 15) != 0) {
 		shore_sides |= cs_steps(sub_tiles ? tile >> ivec2(1) : tile) << 16;
 	}
+	}
 	VERTEX = (VIEW_MATRIX * vec4(world_pos, 1.0)).xyz;
 	NORMAL = (VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
 }
@@ -643,6 +652,12 @@ vec3 contour_land_soft(vec2 p, float band, float px_km, out int g) {
 }
 
 void fragment() {
+	if (dbg_mode == 1 || dbg_mode == 3) {
+		ALBEDO = vec3(0.12, 0.25, 0.1);
+		ROUGHNESS = 1.0;
+		shadow_share = 1.0;
+		NORMAL = normalize((VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz);
+	} else {
 	int ground = ground_bits & 15;
 	int ground_alt = (ground_bits >> 4) & 15;
 	int ground_tip = (ground_bits >> 8) - 1;
@@ -1053,6 +1068,7 @@ void fragment() {
 	shadow_share = rough < 1.0 ? WATER_SHADOW : 1.0; // the water's tops (not its sand)
 	// tops and walls are lit as flat ground; the fixed tones above do the relief
 	NORMAL = normalize((VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz);
+	}
 }
 
