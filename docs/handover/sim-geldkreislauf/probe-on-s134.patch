+    /// S132 (probe): what divorced wives take from the money of their
+    /// husband's household (the household's and its farm's): one share as
+    /// one of its adults, taken from it now: (her household, share, his).
+    fn divorce_shares(&mut self, wives: &[(u32, u32)]) -> Vec<(u32, i64, u32)> {
+        let mut out = Vec::new();
+        for &(from, to) in wives {
+            let Some(s) = self.hh.get(&from).copied() else { continue };
+            let farm = if s.farm != NONE && self.farms[s.farm as usize].hh == from { s.farm } else { NONE };
+            let farm_money = if farm != NONE { self.farms[farm as usize].money.max(0) } else { 0 };
+            let adults = self.info.get(&from).map_or(0, |i| i.adults as i64);
+            let share = (s.money.max(0) + farm_money) / (adults + 1);
+            if share <= 0 {
+                continue;
+            }
+            let from_hh = share.min(s.money.max(0));
+            self.hh.get_mut(&from).unwrap().money -= from_hh;
+            if farm != NONE {
+                self.farms[farm as usize].money -= share - from_hh;
+            }
+            out.push((to, share, from));
+        }
+        out
+    }
+
+    /// S132 (probe): the sons' equal shares of their father's money (the
+    /// household's and its farm's), taken from it now: (son, share,
+    /// father's household). Splits are listed by the father's household.
+    fn money_shares(&mut self, log: &[(u32, u32)]) -> Vec<(u32, i64, u32)> {
+        let mut out = Vec::new();
+        let mut k = 0;
+        while k < log.len() {
+            let old = log[k].0;
+            let n_log = log[k..].iter().take_while(|e| e.0 == old).count();
+            let sons: Vec<u32> = log[k..k + n_log].iter().map(|e| e.1).filter(|id| *id != old && self.info.contains_key(id)).collect();
+            k += n_log;
+            let Some(s) = self.hh.get(&old).copied() else { continue };
+            let farm = if s.farm != NONE && self.farms[s.farm as usize].hh == old { s.farm } else { NONE };
+            let farm_money = if farm != NONE { self.farms[farm as usize].money.max(0) } else { 0 };
+            let total = s.money.max(0) + farm_money;
+            if sons.is_empty() || total <= 0 {
+                continue;
+            }
+            let n = sons.len() as i64 + self.info.contains_key(&old) as i64;
+            let share = total / n;
+            let take = share * sons.len() as i64;
+            let from_hh = take.min(s.money.max(0));
+            self.hh.get_mut(&old).unwrap().money -= from_hh;
+            if farm != NONE {
+                self.farms[farm as usize].money -= take - from_hh;
+            }
+            for son in sons {
+                out.push((son, share, old));
+            }
+        }
+        out
+    }
